# ==============================
# VendaFlow — Node/tRPC + React
# ==============================
NODE_ENV=development
PORT=3000

# PostgreSQL usado pelo Node/tRPC (URL sem o prefixo jdbc:)
DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/banco1

# Login local de desenvolvimento
LOCAL_DEV_AUTH=true
LOCAL_DEV_OPEN_ID=local-admin
MANUS_JWT_SECRET=troque-por-um-segredo-local

# OAuth Manus — preencher somente no Preview/produção
MANUS_PROJECT_ID=
MANUS_OAUTH_API_URL=
OWNER_OPEN_ID=

# ==============================
# VendaFlow — Spring Boot
# ==============================
SERVER_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/banco1
DB_USERNAME=postgres
DB_PASSWORD=SUA_SENHA
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
SERVER_ERROR_INCLUDE_MESSAGE=never
