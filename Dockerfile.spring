FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /build
COPY pom.xml ./
COPY src ./src
RUN mvn -DskipTests package

FROM eclipse-temurin:17-jre
WORKDIR /app
ENV SERVER_PORT=8080
ENV JPA_DDL_AUTO=update
COPY --from=build /build/target/vendaflow-backend-1.0.0.jar /app/vendaflow-backend.jar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/vendaflow-backend.jar"]
