NODE_ENV=production
PORT=3038
DATABASE_URL=postgresql://postgres:TROQUE_A_SENHA@postgres:5432/banco1

# Banco usado pelos containers
POSTGRES_DB=banco1
POSTGRES_USER=postgres
POSTGRES_PASSWORD=TROQUE_A_SENHA_FORTE

# Backend Spring Boot
SERVER_PORT=8080
DB_URL=jdbc:postgresql://postgres:5432/banco1
DB_USERNAME=postgres
DB_PASSWORD=TROQUE_A_SENHA_FORTE
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
SERVER_ERROR_INCLUDE_MESSAGE=never

# Login local do VPS (use credenciais fortes e troque os valores abaixo)
LOCAL_LOGIN_ENABLED=true
LOCAL_ADMIN_LOGIN=admin
LOCAL_ADMIN_PASSWORD=TROQUE_POR_UMA_SENHA_FORTE
LOCAL_ADMIN_NAME=Administrador
LOCAL_ADMIN_EMAIL=admin@vendaflow.professor-anderson.com
LOCAL_DEV_AUTH=false
LOCAL_DEV_OPEN_ID=local-admin
MANUS_JWT_SECRET=TROQUE_POR_UM_SEGREDO_LONGO

# OAuth Manus, caso habilitado
MANUS_PROJECT_ID=
MANUS_OAUTH_API_URL=
OWNER_OPEN_ID=
